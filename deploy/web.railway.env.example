# Railway injects PORT automatically.
PUBLIC_ORIGIN=https://REPLACE-WITH-WEB-DOMAIN
GAME_SERVER_URL=wss://REPLACE-WITH-MACHINE-DOMAIN
CHAIN_ID=84532

# Server-side YokefellowNetwork connection. Never expose this App API key to
# browser JavaScript.
YF_NETWORK_BASE_URL=https://REPLACE-WITH-YOKEFELLOW-NETWORK-DOMAIN
YF_NETWORK_BUCKET_ID=REPLACE_WITH_NETWORK_BUCKET_ID
YF_NETWORK_APP_API_KEY=REPLACE_WITH_COIN_PUSHER_NETWORK_APP_KEY

YES_PUSHER_MACHINE_BUILD_TARGET=50

# Mount a Railway volume at /data before production use.
YES_PUSHER_COMMUNITY_BUILD_STATE_PATH=/data/yd8-workshop-state.json

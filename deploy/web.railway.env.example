# Railway injects PORT automatically.
PUBLIC_ORIGIN=https://REPLACE-WITH-WEB-DOMAIN
GAME_SERVER_URL=wss://REPLACE-WITH-MACHINE-DOMAIN
CHAIN_ID=84532
SESSION_TTL_SECONDS=14400
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Leave automatic minting unset until it is intentionally enabled.
# YF_NFT_MINT_PRIVATE_KEY=
# YF_INSTANT_MINT_SECRET=

# Server-side Yokefellow reads and atomic craft execution.
# Never expose the App API key to browser JavaScript.
YF_API_BASE_URL=https://REPLACE-WITH-YOKEFELLOW-DOMAIN
YF_BUCKET_ID=REPLACE_WITH_BUCKET_ID
YF_APP_API_KEY=REPLACE_WITH_EXISTING_COIN_PUSHER_APP_SECRET
YF_RPC_URL=https://sepolia.base.org

# YD-4 Large-Toy community contribution burn.
# Use a dedicated server-only signer authorized for app burn on the Toy collection.
YF_CONTRIBUTION_BURN_PRIVATE_KEY=
YES_PUSHER_MACHINE_BUILD_TARGET=50

# Mount a Railway volume at /data before production use.
YES_PUSHER_COMMUNITY_BUILD_STATE_PATH=/data/yd4-workshop-state.json

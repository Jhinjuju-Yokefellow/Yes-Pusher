# Railway injects PORT automatically. start-machine.sh maps it to Godot.
YES_PUSHER_NETWORK_MODE=server
YES_PUSHER_SERVER_BIND=*
YES_PUSHER_TRANSPORT=websocket
YES_PUSHER_SNAPSHOT_RATE=10
YES_PUSHER_STATE_PATH=/data/yes-pusher-shared-state.json

# YokefellowNetwork connection. Keep this App API key server-side only.
YF_NETWORK_BASE_URL=https://REPLACE-WITH-YOKEFELLOW-NETWORK-DOMAIN
YF_NETWORK_BUCKET_ID=REPLACE_WITH_NETWORK_BUCKET_ID
YF_NETWORK_APP_API_KEY=REPLACE_WITH_COIN_PUSHER_NETWORK_APP_KEY

YES_DROP_TURN_CAPTURE_ACTION_KEY=yes_drop.turn.capture
YES_DROP_TURN_PAYOUT_ACTION_KEY=yes_drop.turn.payout
YES_DROP_SKIN_ACTION_KEY=yes_pusher.skin_drop
YES_DROP_TOY_ACTION_KEY=yes_pusher.toy_caught

YES_PUSHER_SKIN_DROP_OFFERING_NAME=Coin Skin Drop
YES_PUSHER_TOY_OFFERING_NAME=Catch a Toy

YES_PUSHER_TURN_PRICE_YES_RAW=10000000000000000000
YES_PUSHER_YES_PER_PAYOUT_RAW=1000000000000000000

# One non-stacking hourly free turn. Cooldown begins when the authoritative
# free turn completes.
YES_PUSHER_FREE_TURN_COOLDOWN_SECONDS=3600
YES_PUSHER_TEST_FREE_TURNS=false
YES_PUSHER_PRESENTATION_TEST_MODE=false
YES_PUSHER_ALLOW_UNVERIFIED_WALLETS=false

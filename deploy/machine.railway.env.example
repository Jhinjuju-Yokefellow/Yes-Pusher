# Railway injects PORT automatically. start-machine.sh maps it to Godot.
YES_PUSHER_NETWORK_MODE=server
YES_PUSHER_SERVER_BIND=*
YES_PUSHER_TRANSPORT=websocket
YES_PUSHER_SNAPSHOT_RATE=10
YES_PUSHER_STATE_PATH=/data/yes-pusher-shared-state.json

# Yokefellow connection. Keep the app key only on this machine service.
YF_API_BASE_URL=https://REPLACE-WITH-YOKEFELLOW-DOMAIN
YF_BUCKET_ID=bucket_78de9370-1f1d-4075-8145-1fba4d76b48b
YF_APP_API_KEY=REPLACE_WITH_EXISTING_COIN_PUSHER_APP_SECRET
YES_PUSHER_APP_SLUG=coin-pusher

# These must match the saved app-connection permissions.
YES_PUSHER_SPEND_EVENT_TYPE=coin_drop_started
YES_PUSHER_CREDIT_EVENT_TYPE=coin_drop_completed
YES_PUSHER_SKIN_EVENT_TYPE=skin_drop_earned
YES_PUSHER_TOY_EVENT_TYPE=toy_caught

YES_PUSHER_SKIN_DROP_TRIGGER_KEY=yes_pusher.skin_drop
YES_PUSHER_SKIN_DROP_OFFERING_NAME=Coin Skin Drop
YES_PUSHER_TOY_TRIGGER_KEY=yes_pusher.toy_caught
YES_PUSHER_TOY_OFFERING_NAME=Catch a Toy

YES_PUSHER_TURN_PRICE_YES_RAW=10000000000000000000
YES_PUSHER_YES_PER_PAYOUT_RAW=1000000000000000000
YES_PUSHER_TEST_FREE_TURNS=false

YF_SESSION_VERIFY_URL=https://REPLACE-WITH-WEB-DOMAIN/auth/session/verify
YES_PUSHER_ALLOW_UNVERIFIED_WALLETS=false

# Leave automatic minting unset until it is intentionally enabled.
# YF_INSTANT_MINT_URL=https://REPLACE-WITH-WEB-DOMAIN/mint/instant
# YF_INSTANT_MINT_SECRET=

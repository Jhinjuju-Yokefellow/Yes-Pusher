FROM debian:bookworm-slim

ARG GODOT_VERSION=4.7-beta3
ARG GODOT_ARCH=linux.x86_64

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        unzip \
        libasound2 \
        libdbus-1-3 \
        libfontconfig1 \
        libgl1 \
        libpulse0 \
        libudev1 \
        libx11-6 \
        libxcursor1 \
        libxi6 \
        libxinerama1 \
        libxrandr2 \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --location --retry 5 --retry-delay 2 \
      "https://github.com/godotengine/godot-builds/releases/download/${GODOT_VERSION}/Godot_v${GODOT_VERSION}_${GODOT_ARCH}.zip" \
      --output /tmp/godot.zip \
    && unzip -q /tmp/godot.zip -d /tmp/godot \
    && install -m 0755 "/tmp/godot/Godot_v${GODOT_VERSION}_${GODOT_ARCH}" /usr/local/bin/godot \
    && rm -rf /tmp/godot /tmp/godot.zip

WORKDIR /app
COPY project.godot export_presets.cfg icon.svg ./
COPY *.tscn ./
COPY scripts ./scripts
COPY assets ./assets
COPY deploy/start-machine.sh /usr/local/bin/start-yes-pusher-machine

RUN chmod +x /usr/local/bin/start-yes-pusher-machine \
    && mkdir -p /data /data/godot-home

ENV HOME=/data/godot-home
EXPOSE 8787
STOPSIGNAL SIGTERM
CMD ["/usr/local/bin/start-yes-pusher-machine"]

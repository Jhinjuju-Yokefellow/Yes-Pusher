# YES drop web shell.
# The browser never receives the YokefellowNetwork App API key.
PORT=8080
PUBLIC_ORIGIN=http://127.0.0.1:8080
GAME_SERVER_URL=ws://127.0.0.1:8787
CHAIN_ID=84532

# Server-side YokefellowNetwork connection used by the web shell for
# participant auth, holdings, craft, contribution, and funding.
YF_NETWORK_BASE_URL=REPLACE_WITH_YOKEFELLOW_NETWORK_URL
YF_NETWORK_BUCKET_ID=REPLACE_WITH_NETWORK_BUCKET_ID
YF_NETWORK_APP_API_KEY=REPLACE_WITH_NETWORK_APP_API_KEY

YES_PUSHER_MACHINE_BUILD_TARGET=50
YES_PUSHER_COMMUNITY_BUILD_STATE_PATH=.local/yd8-workshop-state.json

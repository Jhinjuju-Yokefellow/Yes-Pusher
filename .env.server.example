# Local authoritative YES DROP machine configuration.
# Copy to .env.server and fill the three Yokefellow connection values below.
# Existing test deployment values live on Railway -> yes-pusher-machine -> Variables.
#
# Do not commit .env.server.

YES_PUSHER_NETWORK_MODE=server
YES_PUSHER_SERVER_BIND=*
YES_PUSHER_TRANSPORT=websocket
YES_PUSHER_SERVER_PORT=8787
YES_PUSHER_SNAPSHOT_RATE=10
YES_PUSHER_STATE_PATH=user://yes-pusher-shared-state.json

# Yokefellow connection. Copy these from the existing yes-pusher-machine Railway service.
YF_API_BASE_URL=REPLACE_WITH_YOKEFELLOW_URL
# Use the Yokefellow Bucket slug or DB bucket_... ID here. Do NOT use the 0x...
# Network Bucket ID; the App SDK resolves the Bucket first, then forwards the
# Bucket's Network ID internally for holdings/action execution.
YF_BUCKET_ID=REPLACE_WITH_BUCKET_SLUG_OR_DB_ID
YF_APP_API_KEY=REPLACE_WITH_APP_API_KEY
YES_PUSHER_APP_SLUG=yes-drop

YES_PUSHER_TURN_PRICE_YES_RAW=10000000000000000000
YES_PUSHER_YES_PER_PAYOUT_RAW=1000000000000000000
YES_PUSHER_FREE_TURN_COOLDOWN_SECONDS=3600
YES_PUSHER_TEST_FREE_TURNS=false
YES_PUSHER_ALLOW_UNVERIFIED_WALLETS=false

# PREPARE-WEB-PLAYER.ps1 rewrites this to the local wallet verifier.
YF_SESSION_VERIFY_URL=http://127.0.0.1:8080/auth/session/verify

# NFT reads come from the Network-backed Yokefellow SDK holdings projection.
# A failed holdings read is an empty NFT inventory; persisted machine state is
# never allowed to act as an NFT ownership/equip cache.
# NFT writes execute only through Yokefellow Action Paths; no local mint key is used.

# YD-4 Workshop / community machine build.
YES_PUSHER_MACHINE_BUILD_TARGET=50
YES_PUSHER_COMMUNITY_BUILD_STATE_PATH=.local/yd4-workshop-state.json